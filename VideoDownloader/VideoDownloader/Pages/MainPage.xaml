<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VideoDownloader.Pages.MainPage"
             x:Name="OverviewPage"
             BackgroundColor="#0F0F0F">

    <Grid RowDefinitions="Auto, *, Auto" Padding="25">

        <Label Grid.Row="0" 
               Text="MP4 and MP3 Downloader" 
               FontSize="30" 
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center" 
               Margin="0,20"/>

        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center">

            <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1C1C1C" Padding="15,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="UrlEntry" 
                       Placeholder="Paste YouTube link here..." 
                       PlaceholderColor="Gray"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       HeightRequest="55"/>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Destination Folder:" TextColor="Gray" FontSize="14" Margin="5,0"/>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Stroke="#333333" BackgroundColor="#1C1C1C" Padding="15,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label x:Name="PathLabel" 
                               Text="Select a folder..." 
                               VerticalOptions="Center" 
                               TextColor="White" 
                               LineBreakMode="HeadTruncation"/>
                    </Border>
                    <Button Grid.Column="1" 
                            Text="📁" 
                            Clicked="OnSelectPathClicked" 
                            WidthRequest="55" 
                            BackgroundColor="#512BD4" 
                            TextColor="White"
                            CornerRadius="8"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Video Quality:" TextColor="Gray" FontSize="14" Margin="5,0"/>
                <Border Stroke="#512BD4" 
                        StrokeThickness="2" 
                        BackgroundColor="#1C1C1C" 
                        Padding="10,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Picker x:Name="QualityPicker" 
                            Title="Select Quality" 
                            TitleColor="Gray"
                            TextColor="Cyan" 
                            FontSize="18"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill">
                        <Picker.Items>
                            <x:String>Best Available</x:String>
                            <x:String>1080p</x:String>
                            <x:String>720p</x:String>
                            <x:String>480p</x:String>
                            <x:String>360p</x:String>
                        </Picker.Items>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Audio Quality (MP3):" TextColor="Gray" FontSize="14" Margin="5,0"/>
                <Border Stroke="#1DB954" StrokeThickness="2" BackgroundColor="#1C1C1C" Padding="10,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Picker x:Name="AudioQualityPicker" 
                Title="Select Bitrate" 
                TextColor="#1DB954" 
                TitleColor="Gray"
                FontSize="18">
                        <Picker.Items>
                            <x:String>Best Available</x:String>
                            <x:String>320 kbps</x:String>
                            <x:String>256 kbps</x:String>
                            <x:String>128 kbps</x:String>
                        </Picker.Items>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <Button Text="Download MP4 (Video)" 
                    Clicked="OnDownloadMp4Clicked"
                    BackgroundColor="#B91C1C"
                    TextColor="White"
                    HeightRequest="60"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Margin="0,10,0,0"/>

            <Button Text="Download MP3 (Audio)" 
                    Clicked="OnDownloadMp3Clicked"
                    BackgroundColor="#1DB954"
                    TextColor="White"
                    HeightRequest="60"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"/>

            <VerticalStackLayout Spacing="10" Margin="0,15">
                <Label x:Name="StatusLabel" 
                       Text="Waiting for link..." 
                       HorizontalOptions="Center" 
                       FontSize="16" 
                       TextColor="Gray"/>
                <ActivityIndicator x:Name="Cargando" 
                                   IsRunning="False" 
                                   HorizontalOptions="Center" 
                                   Color="Cyan" 
                                   Scale="1.5"/>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <Label Grid.Row="2" 
               Text="Ready for download" 
               HorizontalOptions="Center" 
               TextColor="Gray" 
               Opacity="0.6" 
               Margin="0,0,0,10"/>
    </Grid>
</ContentPage>